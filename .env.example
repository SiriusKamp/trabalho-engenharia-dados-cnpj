# Valores públicos de demonstração; credenciais privadas ficam apenas no .env do servidor.
# Crie sua cópia com: Copy-Item .env.example .env
# Docker Compose lê .env na raiz; este .example serve somente como modelo.
# As portas publicadas são configuradas em compose.yaml, na seção ports de cada serviço.
# Inclui o mês atual e N-1 anteriores; nunca apaga o histórico que já foi importado.
MESES=4
# Downloads paralelos; extração e transformação continuam sequenciais.
DOWNLOAD_WORKERS=3
# 0 permite estudar e executar manualmente; 1 inicia as rotinas junto com a API.
AGENDAMENTO_ATIVO=0
# Cada credencial da API corresponde a uma role; detalhes em CREDENCIAIS.md.
ENGENHARIA_USUARIO=engenharia
ENGENHARIA_SENHA=Engenharia123!
ANALISE_USUARIO=analise
ANALISE_SENHA=Analise123!
MONITORAMENTO_USUARIO=monitor
MONITORAMENTO_SENHA=Monitor123!
GRAFANA_USUARIO=admin
GRAFANA_SENHA=admin
# Spark local[2] utiliza duas threads. A JVM fica dentro do limite de 6 GB do serviço app.
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=16
# Depois de mudar variáveis, aplique com: docker compose up -d --force-recreate
# Pode apontar para o volume criptografado do servidor.
DIRETORIO_DATA=./DATA
# Volume nomeado Linux do Compose; no servidor pode ser um caminho criptografado.
DIRETORIO_SPARK_TMP=spark-temporarios
DIRETORIO_TLS=./.certificados
# Para HTTPS nativo da API, caminhos dentro do container:
TLS_CERTIFICADO=
TLS_CHAVE=
GRAFANA_PROTOCOLO=http
GRAFANA_CERTIFICADO=
GRAFANA_CHAVE=
